{% comment %}
  Aufzeichnungen
  - 3/2/1 responsive grid
  - shows thumbnail first
  - on click replaces thumbnail with inline YouTube iframe (stays on page)
{% endcomment %}

<section class="wrp section-{{ section.id }}">
  <div class="wrp__inner">
    {% if section.settings.heading != blank %}
      <h2 class="wrp__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wrp__grid">
      {% for block in section.blocks %}
        {% assign id = block.settings.youtube_id | strip %}
        {% if id != blank %}
          <article class="wrp__card" {{ block.shopify_attributes }}>
            <div class="wrp__player ytlite"
                 data-video-id="{{ id | escape }}"
                 aria-label="{{ block.settings.title | escape }}">
              <button class="ytlite__btn" type="button" aria-label="Replay abspielen">
                <img
                  class="ytlite__thumb"
                  src="https://i.ytimg.com/vi/{{ id }}/hqdefault.jpg"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="1280"
                  height="720"
                >
                <span class="ytlite__play" aria-hidden="true"></span>
              </button>
            </div>

            {% if block.settings.title != blank %}
              <h3 class="wrp__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.meta != blank %}
              <div class="wrp__meta">{{ block.settings.meta }}</div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  /* =========================
     ABSTÄNDE (links/rechts/unten)
     ========================= */

  .section-{{ section.id }}{
    padding-bottom: 80px; /* mehr Abstand unten */
  }

  /* Innerer Rand links/rechts (unabhängig vom Theme) */
  .section-{{ section.id }} .wrp__inner{
    padding-left: 40px;
    padding-right: 40px;
  }

  @media (max-width: 990px){
    .section-{{ section.id }}{
      padding-bottom: 60px;
    }
    .section-{{ section.id }} .wrp__inner{
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media (max-width: 750px){
    .section-{{ section.id }}{
      padding-bottom: 48px;
    }
    .section-{{ section.id }} .wrp__inner{
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  /* =========================
     TYPO / GRID
     ========================= */

  .section-{{ section.id }} .wrp__heading{
    margin: 0 0 18px;
    font-size: 22px;
    line-height: 1.2;
  }

  /* Grid: 3 / 2 / 1 */
  .section-{{ section.id }} .wrp__grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 990px){
    .section-{{ section.id }} .wrp__grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 750px){
    .section-{{ section.id }} .wrp__grid{ grid-template-columns: 1fr; }
  }

  /* Card */
  .section-{{ section.id }} .wrp__card{
    border: 1px solid rgba(0,0,0,.10);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }
  .section-{{ section.id }} .wrp__title{
    margin: 12px 14px 4px;
    font-size: 16px;
    line-height: 1.25;
  }
  .section-{{ section.id }} .wrp__meta{
    margin: 0 14px 14px;
    font-size: 13px;
    opacity: .75;
  }

  /* Thumbnail -> Inline player */
  .section-{{ section.id }} .ytlite{ position: relative; width: 100%; background:#000; }
  .section-{{ section.id }} .ytlite::before{ content:""; display:block; padding-top:56.25%; } /* 16:9 */
  .section-{{ section.id }} .ytlite__btn{ position:absolute; inset:0; width:100%; height:100%; border:0; padding:0; background:transparent; cursor:pointer; }
  .section-{{ section.id }} .ytlite__thumb{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .section-{{ section.id }} .ytlite__play{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    width:86px; height:60px; border-radius:16px;
    background:rgba(0,0,0,.55);
  }
  .section-{{ section.id }} .ytlite__play::before{
    content:""; position:absolute; left:36px; top:18px;
    width:0; height:0; border-left:18px solid #fff;
    border-top:12px solid transparent; border-bottom:12px solid transparent;
  }
  .section-{{ section.id }} .ytlite iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }
</style>

<script>
  (function(){
    // scope to this section only
    const scope = document.querySelector('.section-{{ section.id }}');
    if (!scope) return;

    scope.querySelectorAll('.ytlite').forEach(function(root){
      const videoId = root.getAttribute('data-video-id');
      const btn = root.querySelector('.ytlite__btn');
      if (!videoId || !btn) return;

      btn.addEventListener('click', function(){
        const iframe = document.createElement('iframe');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('title', root.getAttribute('aria-label') || 'YouTube video');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0';

        root.innerHTML = '';
        root.appendChild(iframe);
      }, { once: true });
    });
  })();
</script>

{% schema %}
{
  "name": "Aufzeichnungen",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Aufzeichnungen"
    }
  ],
  "blocks": [
    {
      "type": "replay",
      "name": "Replay",
      "settings": [
        {
          "type": "text",
          "id": "youtube_id",
          "label": "YouTube Video-ID",
          "info": "Beispiel: Bei https://www.youtube.com/watch?v=ABC123 ist die ID: ABC123"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Webinar Titel"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta (z. B. Dauer • Datum)",
          "default": "58 Min • 2025-11-12"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Webinar Replays Grid (YouTube)",
      "blocks": [
        { "type": "replay" },
        { "type": "replay" },
        { "type": "replay" }
      ]
    }
  ]
}
{% endschema %}
