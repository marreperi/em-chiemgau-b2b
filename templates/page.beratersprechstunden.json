l":"Zur Anmeldung","link":""}},"column_qgrtE4":{"type":"column","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/Flo_Garten.png","title":"Dienstag 02.06.2026: \"Garten\" um 8:30 Uhr","text":"","link_label":"Zur Anmeldung","link":""}}},"block_order":["column_VzebFT","column_brYBi4","column_nWwU6J","column_HnGjBD","column_i6VJX7","column_6Fkrqr","column_t4YMNk","column_qgrtE4"],"disabled":true,"name":"t:sections.multicolumn.presets.name","settings":{"title":"Unsere Händlerdialoge:","heading_size":"h1","image_width":"full","image_ratio":"adapt","button_label":"","button_link":"","columns_desktop":4,"column_alignment":"center","background_style":"none","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"padding_top":0,"padding_bottom":24}},"rich_text_M3fNYd":{"type":"rich-text","blocks":{"heading_cD8X3W":{"type":"heading","settings":{"heading":"<strong>Schee wars! <\/strong>Der EM-Chiemgau Händlertag - am 21. Februar 2026","heading_size":"h2"}}},"block_order":["heading_cD8X3W"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":0,"padding_bottom":20}},"rich_text_3ULRBa":{"type":"rich-text","blocks":{"text_y4zY9F":{"type":"text","settings":{"text":"<p>Schön war’s mit euch! Vielen Dank für euer Interesse, eure Offenheit und den regen Austausch. Besonders wertvoll war es, Gleichgesinnte zu treffen, Erfahrungen zu teilen und gemeinsam den Sinn unserer Arbeit in den Mittelpunkt zu stellen.<br\/><\/p><p><strong>Der Händlertag hat uns wieder deutlich gemacht:<\/strong><br\/>Wir alle arbeiten nicht nur mit Produkten, sondern mit einer Haltung. Mit dem Wunsch, nachhaltige Lösungen in die Welt zu bringen – ehrlich, wirksam und mit Verantwortung.<\/p><p>Danke für eure Zeit, eure Impulse und eure Verbundenheit.<\/p><p><strong>Wir freuen uns auf alles, was wir gemeinsam weiterentwickeln!<\/strong><\/p><p><\/p><p><strong>Downloads & Infos vom Händlertag:<\/strong><\/p><ul><li>Aufzeichnung Vortrag Christoph Fischer <a href=\"https:\/\/www.youtube.com\/watch?v=euTfKzGVDcg\" title=\"https:\/\/www.youtube.com\/watch?v=euTfKzGVDcg\">(Youtube-Link)<\/a><\/li><li>Videoaufzeichnung Vortrag von Stefan Hügel <a href=\"https:\/\/youtu.be\/uLRZ2qXAMo8?si=x467pLyXhDRGWQ8c\" title=\"https:\/\/youtu.be\/uLRZ2qXAMo8?si=x467pLyXhDRGWQ8c\">(Youtube-Link)<\/a><\/li><li>Handout Unterlagen Workshops <a href=\"https:\/\/em-chiemgau.de\/wp-content\/uploads\/2026\/02\/Haendlertag-2026-Handout.pdf\" target=\"_blank\" title=\"https:\/\/em-chiemgau.de\/wp-content\/uploads\/2026\/02\/Haendlertag-2026-Handout.pdf\">(Download Link)<\/a><\/li><li>Umfrage Händlertag <a href=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLScSKrX-F2CTAwio8_kY4aD2VKD3TeWrfbDfwig8XoLQ4KLGTg\/viewform?usp=publish-editor\" target=\"_blank\" title=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLScSKrX-F2CTAwio8_kY4aD2VKD3TeWrfbDfwig8XoLQ4KLGTg\/viewform?usp=publish-editor\">(Jetzt teilnehmen)<\/a><\/li><li>Handout von Referentin Susanne Janthur <a href=\"https:\/\/em-chiemgau.de\/wp-content\/uploads\/2026\/02\/Handout-zum-Impuls-vom-Haendlertag-bei-Fischers-EM-am-21.-Februar-2026.pdf\" target=\"_blank\" title=\"https:\/\/em-chiemgau.de\/wp-content\/uploads\/2026\/02\/Handout-zum-Impuls-vom-Haendlertag-bei-Fischers-EM-am-21.-Februar-2026.pdf\">(Download Link)<\/a><\/li><\/ul><p><\/p><p><a href=\"https:\/\/haendler.em-chiemgau.de\/pages\/veranstaltungen\" title=\"https:\/\/haendler.em-chiemgau.de\/pages\/veranstaltungen\">Sei dabei! Der nächste Online-Dialog für Händler - Austausch, Fragen klären, Neues erfahren! <strong>Jetzt anmelden!<\/strong><\/a><\/p>"}}},"block_order":["text_y4zY9F"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"left","color_scheme":"","full_width":true,"padding_top":0,"padding_bottom":36}},"multicolumn_mYDm4W":{"type":"multicolumn","blocks":{"column_aiynb7":{"type":"col